# Copy to .env. Node loads it with --env-file (see README). Never commit .env.

# --- LLM: local Strata only. The base URL MUST be loopback; anything else is refused at startup.
PIAGENT_LLM_BASE_URL=http://127.0.0.1:8080/v1
PIAGENT_LLM_MODEL=qwen3.8-flash-next-iq3_s
PIAGENT_LLM_API_KEY_FILE=/home/kiwi/llm-rig/strata/.config/strata/api-key
PIAGENT_LLM_CONTEXT_WINDOW=131072
PIAGENT_LLM_MAX_OUTPUT_TOKENS=8000
PIAGENT_LLM_THINKING=low
PIAGENT_LLM_REQUEST_TIMEOUT_SECONDS=600

# --- Oracle targets (19c only). Passwords are read from files in the secret dir, never from here.
PIAGENT_TARGETS_FILE=./config/targets.json
PIAGENT_SECRET_DIR=/home/kiwi/OracleDBHarness/databases/secrets
PIAGENT_DEFAULT_TARGET=d1-19c-lab

# --- Execution limits
PIAGENT_MAX_ROWS=200
PIAGENT_STATEMENT_TIMEOUT_SECONDS=30
PIAGENT_MAX_TOOL_RESULT_BYTES=16384
PIAGENT_MAX_TOOL_CALLS=20
PIAGENT_MAX_WALL_SECONDS=300

# --- Audit
PIAGENT_AUDIT_FILE=./var/audit.jsonl
# PIAGENT_REPORT_DIRECTORY=./var/reports
