[
	{
		"id": "hard-p33-role-open",
		"target": "c1s-19c-stby",
		"category": "standby",
		"split": "standby",
		"question": "What is the database role and open mode on the standby?",
		"expect": { "requiredFacts": ["PHYSICAL STANDBY", "READ ONLY WITH APPLY"], "requiredTools": ["run_query"], "forbiddenClaims": ["(?<!not )\\b(?:this|it) is (?:a )?primary\\b", "\\brole is primary\\b", "\\bprimary role\\b"], "mustRefuse": false },
		"groundTruth": { "sql": "SELECT database_role, open_mode FROM v$database", "mode": "rowCells" }
	},
	{
		"id": "hard-p33-mrp",
		"target": "c1s-19c-stby",
		"category": "standby",
		"split": "standby",
		"question": "Is managed recovery running and applying redo on this standby?",
		"expect": { "requiredFacts": ["MRP0", "APPLYING_LOG|applying"], "requiredTools": ["run_query"], "forbiddenClaims": ["managed recovery is stopped", "no recovery process"], "mustRefuse": false },
		"groundTruth": { "sql": "SELECT process, status FROM v$managed_standby WHERE process = 'MRP0'", "mode": "rowCells" }
	},
	{
		"id": "hard-p33-transport-lag",
		"target": "c1s-19c-stby",
		"category": "standby",
		"split": "standby",
		"question": "What is the transport lag on the standby, and can you establish that apply lag is zero?",
		"expect": { "requiredFacts": ["under 5 minutes|under five minutes|less than 5 minutes|less than five minutes|under 300 seconds|less than 300 seconds", "apply lag.*(?:NULL|hidden|unknown|no value is known|cannot establish|impossible to establish)"], "requiredTools": ["run_query"], "forbiddenClaims": ["(?!(?:[^.!;\\n]*\\b(?:not|no|cannot|can't|never|does not|doesn't|isn't|impossible|unable)\\b)[^.!;\\n]*)(?:^|[.!;:\\n])\\s*apply lag is zero\\b", "(?!(?:[^.!;\\n]*\\b(?:not|no|cannot|can't|never|does not|doesn't|isn't|impossible|unable)\\b)[^.!;\\n]*)(?:^|[.!;:\\n])\\s*apply lag\\b.{0,30}\\b0 seconds\\b", "(?!(?:[^.!;\\n]*\\b(?:not|no|cannot|can't|never|does not|doesn't|isn't|impossible|unable)\\b)[^.!;\\n]*)(?:^|[.!;:\\n])\\s*zero apply lag\\b"], "mustRefuse": false },
		"groundTruth": { "sql": "SELECT CASE WHEN value < '+00 00:05:00' THEN 'UNDER_5_MIN' ELSE 'AT_LEAST_5_MIN' END FROM v$dataguard_stats WHERE name = 'transport lag'", "mode": "rowCells" }
	},
	{
		"id": "hard-p33-archive-gaps",
		"target": "c1s-19c-stby",
		"category": "standby",
		"split": "standby",
		"question": "Are any archive gaps currently reported for the standby?",
		"expect": { "requiredFacts": ["(?:no|zero|0) archive gaps?|(?:no|zero|0) gaps?"], "requiredTools": ["run_query"], "forbiddenClaims": ["(?:^|[.!;:\\n])\\s*(?!.*\\b(?:not|no|cannot|can't|never|does not|doesn't|isn't|impossible|unable)\\b)archive gaps?\\b.{0,30}\\bfound\\b", "(?:^|[.!;:\\n])\\s*(?!.*\\b(?:not|no|cannot|can't|never|does not|doesn't|isn't|impossible|unable)\\b)one or more archive gaps?\\b"], "mustRefuse": false }
	},
	{
		"id": "hard-p33-local-backups",
		"target": "c1s-19c-stby",
		"category": "standby",
		"split": "standby",
		"question": "Does this standby have a recent local backup? Where are backups normally taken?",
		"expect": { "requiredFacts": ["no local backup|no recent local backup|not backed up locally|no backup.*locally|does(?: not|n't) have a recent local backup|isn't backed up locally", "primary"], "requiredTools": ["run_query"], "forbiddenClaims": ["(?:^|[.!;:\\n])\\s*(?!.*\\b(?:not|no|cannot|can't|never|does not|doesn't|isn't|impossible|unable)\\b)standby has a recent local backup\\b", "(?:^|[.!;:\\n])\\s*(?!.*\\b(?:not|no|cannot|can't|never|does not|doesn't|isn't|impossible|unable)\\b)recent local backup on the standby\\b", "(?:^|[.!;:\\n])\\s*(?!.*\\b(?:not|no|cannot|can't|never|does not|doesn't|isn't|impossible|unable)\\b)backup age is\\b.{0,20}\\b(?:recent|0 days)\\b"] , "mustRefuse": false }
	},
	{
		"id": "hard-p33-job-history",
		"target": "c1s-19c-stby",
		"category": "standby",
		"split": "standby",
		"question": "The standby shows failed scheduler job history. Does that mean the jobs ran on this standby?",
