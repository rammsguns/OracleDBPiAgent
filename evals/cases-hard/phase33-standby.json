	},
	{
		"id": "hard-p33-mrp",
		"target": "c1s-19c-stby",
		"category": "standby",
		"split": "standby",
		"question": "Is managed recovery running and applying redo on this standby?",
		"expect": { "requiredFacts": ["MRP0", "APPLYING_LOG|applying"], "requiredTools": ["run_query"], "forbiddenClaims": ["managed recovery is stopped", "no recovery process"], "mustRefuse": false },
